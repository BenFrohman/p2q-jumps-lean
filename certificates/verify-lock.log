def P2qJumps.Semantics.paper_claim : Prop :=
∀ (p q : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        (p ^ 2 * q + 12).totient = (p ^ 2 * q).totient + 12 →
          (ArithmeticFunction.sigma 1) (p ^ 2 * q + 12) = (ArithmeticFunction.sigma 1) (p ^ 2 * q) + 12 →
            (¬Nat.Prime (p ^ 2 * q + 12) ∧ ∀ (r s : ℕ), Nat.Prime r → Nat.Prime s → r ≠ s → p ^ 2 * q + 12 ≠ r * s) ∧
              (∀ (r s t : ℕ),
                  Nat.Prime r → Nat.Prime s → Nat.Prime t → r ≠ s → r ≠ t → s ≠ t → p ^ 2 * q + 12 ≠ r * s * t) ∧
                (∀ (r s t : ℕ),
                    Nat.Prime r →
                      Nat.Prime s →
                        Nat.Prime t → r ≠ s → r ≠ t → s ≠ t → 5 ≤ r → 5 ≤ s → 5 ≤ t → p ^ 2 * q + 12 ≠ r ^ 2 * s * t) ∧
                  (∀ (r s : ℕ),
                      Nat.Prime r →
                        Nat.Prime s →
                          r ≠ s →
                            5 ≤ r →
                              5 ≤ s → p ^ 2 * q + 12 = r ^ 3 * s → p < r ∧ ↑r ^ 2 ∣ ↑p ^ 3 - ↑p ^ 2 - 12 ∧ 10 ^ 4 < p) ∧
                    10 ^ 4 < p ^ 2 * q
def P2qJumps.Semantics.formal_claim : Prop :=
(∀ (p q : ℕ), Nat.Prime p → Nat.Prime q → p ≠ q → P2qJumps.Jumps (p ^ 2 * q) → ¬Nat.Prime (p ^ 2 * q + 12)) ∧
  (∀ (p q r s : ℕ),
      Nat.Prime p →
        Nat.Prime q → Nat.Prime r → Nat.Prime s → p ≠ q → r ≠ s → P2qJumps.Jumps (p ^ 2 * q) → p ^ 2 * q + 12 ≠ r * s) ∧
    P2qJumps.Theorem28 ∧
      (∀ (p q r s t : ℕ),
          Nat.Prime p →
            Nat.Prime q →
              Nat.Prime r →
                Nat.Prime s →
                  Nat.Prime t →
                    p ≠ q →
                      r ≠ s →
                        r ≠ t →
                          s ≠ t → 5 ≤ r → 5 ≤ s → 5 ≤ t → P2qJumps.Jumps (p ^ 2 * q) → p ^ 2 * q + 12 ≠ r ^ 2 * s * t) ∧
        (∀ (p q r s : ℕ),
            Nat.Prime p →
              Nat.Prime q →
                Nat.Prime r →
                  Nat.Prime s →
                    p ≠ q →
                      r ≠ s →
                        5 ≤ r →
                          5 ≤ s →
                            P2qJumps.Jumps (p ^ 2 * q) →
                              p ^ 2 * q + 12 = r ^ 3 * s → p < r ∧ ↑r ^ 2 ∣ P2qJumps.Lpoly ↑p ∧ 10000 < p) ∧
          ∀ (p q : ℕ), Nat.Prime p → Nat.Prime q → p ≠ q → p ^ 2 * q ≤ 10000 → ¬P2qJumps.Jumps (p ^ 2 * q)
theorem_L : paper_claim
